+// The prebuilt Windows binaries lack this package's native patch: build it, and leave none for the loader to fall back to.
+if (process.platform === 'win32') {
+  for (const name of fs.readdirSync(PREBUILDS_ROOT, { recursive: true })) {
+    if (String(name).startsWith('win32-') && String(name).endsWith('.node')) fs.rmSync(path.join(PREBUILDS_ROOT, String(name)));
+  }
+  process.exit(1);
+}
+
