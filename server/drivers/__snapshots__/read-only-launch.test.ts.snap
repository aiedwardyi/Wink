exports[`read-only launch contract > codex launches a normal turn exactly as before 1`] = `
{
  "thread/resume": {
    "argv": [
      "app-server",
      "-c",
      "web_search="live"",
      "-c",
      "mcp_servers.agents.command="<node>"",
      "-c",
      "mcp_servers.agents.args=["-e","const pairs = JSON.parse(process.argv[1]); const env = { ...process.env }; for (const key of Object.keys(env)) if (key.startsWith(/"WINK_MCP_/")) delete env[key]; for (const [key, scoped] of pairs) env[key] = process.env[scoped]; const child = require(/"node:child_process/").spawn(process.argv[2], process.argv.slice(3), { env, stdio: /"inherit/", windowsHide: true }); child.on(/"error/", () => process.exit(1)); child.on(/"exit/", (code) => process.exit(code ?? 1)); for (const signal of [/"SIGINT/", /"SIGTERM/"]) process.on(signal, () => child.kill(signal));","[[/"OMB_WINK_TOOL_CATALOG/",/"WINK_MCP_AGENTS_OMB_WINK_TOOL_CATALOG/"]]","<node>","-e",""]",
      "-c",
      "mcp_servers.agents.env_vars=["ELECTRON_RUN_AS_NODE","WINK_MCP_AGENTS_OMB_WINK_TOOL_CATALOG"]",
      "-c",
      "mcp_servers.agents.default_tools_approval_mode="auto"",
      "-c",
      "mcp_servers.agents.tool_timeout_sec=300",
    ],
    "params": {
      "approvalPolicy": "never",
      "sandbox": "danger-full-access",
      "threadId": "codex-thread-9",
    },
  },
  "thread/start": {
    "argv": [
      "app-server",
      "-c",
      "web_search="live"",
      "-c",
      "mcp_servers.agents.command="<node>"",
      "-c",
      "mcp_servers.agents.args=["-e","const pairs = JSON.parse(process.argv[1]); const env = { ...process.env }; for (const key of Object.keys(env)) if (key.startsWith(/"WINK_MCP_/")) delete env[key]; for (const [key, scoped] of pairs) env[key] = process.env[scoped]; const child = require(/"node:child_process/").spawn(process.argv[2], process.argv.slice(3), { env, stdio: /"inherit/", windowsHide: true }); child.on(/"error/", () => process.exit(1)); child.on(/"exit/", (code) => process.exit(code ?? 1)); for (const signal of [/"SIGINT/", /"SIGTERM/"]) process.on(signal, () => child.kill(signal));","[[/"OMB_WINK_TOOL_CATALOG/",/"WINK_MCP_AGENTS_OMB_WINK_TOOL_CATALOG/"]]","<node>","-e",""]",
      "-c",
      "mcp_servers.agents.env_vars=["ELECTRON_RUN_AS_NODE","WINK_MCP_AGENTS_OMB_WINK_TOOL_CATALOG"]",
      "-c",
      "mcp_servers.agents.default_tools_approval_mode="auto"",
      "-c",
      "mcp_servers.agents.tool_timeout_sec=300",
    ],
    "params": {
      "approvalPolicy": "never",
      "config": {
        "web_search": "live",
      },
      "cwd": "<scratch>",
      "ephemeral": false,
      "model": null,
      "sandbox": "danger-full-access",
    },
  },
}
`;

